@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-page">
    <div class="auth-background-orb orb-1"></div>
    <div class="auth-background-orb orb-2"></div>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <span class="auth-badge">Acceso seguro</span>
                <h1>@ViewData["Title"]</h1>
                <p>
                    Accede a tu espacio de trabajo para gestionar grupos, chats, calendario y notas
                    desde una única plataforma.
                </p>
            </div>

            <div class="auth-grid">
                <section class="auth-main">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                        <div class="auth-field">
                            <label asp-for="Input.Login">Correo electrónico</label>
                            <input asp-for="Input.Login"
                                   class="auth-input"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="nombre@empresa.com" />
                            <span asp-validation-for="Input.Login" class="field-validation"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Input.Password">Contraseña</label>
                            <input asp-for="Input.Password"
                                   class="auth-input"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="Introduce tu contraseña" />
                            <span asp-validation-for="Input.Password" class="field-validation"></span>
                        </div>

                        <div class="auth-options">
                            <label asp-for="Input.RememberMe" class="remember-me">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <span>Recordarme</span>
                            </label>

                            <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link subtle-link">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>

                        <button id="login-submit" type="submit" class="auth-submit-btn">
                            Iniciar sesión
                        </button>

                        <div class="auth-extra-links">
                            <p>
                                ¿No tienes cuenta?
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">
                                    Regístrate
                                </a>
                            </p>
                            <p>
                                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="auth-link subtle-link">
                                    Reenviar confirmación de correo
                                </a>
                            </p>
                        </div>
                    </form>
                </section>

                <aside class="auth-side">
                    <div class="auth-side-card">
                        <h3>Acceso alternativo</h3>
                        <p>
                            También puedes iniciar sesión usando un servicio externo, si está disponible.
                        </p>

                        @{
                            if ((Model.ExternalLogins?.Count ?? 0) == 0)
                            {
                                <div class="external-empty">
                                    <p>
                                        No hay servicios externos configurados actualmente.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <form id="external-account"
                                      asp-page="./ExternalLogin"
                                      asp-route-returnUrl="@Model.ReturnUrl"
                                      method="post"
                                      class="external-form">
                                    <div class="external-buttons">
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit"
                                                    class="external-btn"
                                                    name="provider"
                                                    value="@provider.Name"
                                                    title="Iniciar sesión con @provider.DisplayName">
                                                Continuar con @provider.DisplayName
                                            </button>
                                        }
                                    </div>
                                </form>
                            }
                        }
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #3B82F6;
        --secondary: #6366F1;
        --background: #F8FAFC;
        --card: #FFFFFF;
        --text: #0F172A;
        --text-secondary: #64748B;
        --success: #22C55E;
        --warning: #F59E0B;
        --error: #EF4444;
        --border-soft: rgba(148, 163, 184, 0.22);
        --shadow-soft: 0 18px 50px rgba(15, 23, 42, 0.08);
        --shadow-hover: 0 18px 35px rgba(59, 130, 246, 0.14);
    }

    .auth-page {
        position: relative;
        min-height: calc(100vh - 140px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        overflow: hidden;
    }

    .auth-background-orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(8px);
        pointer-events: none;
        z-index: 0;
    }

    .orb-1 {
        width: 320px;
        height: 320px;
        top: -80px;
        left: -100px;
        background: radial-gradient(circle, rgba(59,130,246,.16) 0%, rgba(59,130,246,0) 70%);
    }

    .orb-2 {
        width: 380px;
        height: 380px;
        right: -120px;
        bottom: -140px;
        background: radial-gradient(circle, rgba(99,102,241,.14) 0%, rgba(99,102,241,0) 70%);
    }

    .auth-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1120px;
    }

    .auth-card {
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 28px;
        box-shadow: var(--shadow-soft);
        backdrop-filter: blur(16px);
        overflow: hidden;
    }

    .auth-header {
        padding: 36px 36px 10px 36px;
        text-align: center;
    }

    .auth-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(59, 130, 246, 0.08);
        color: var(--primary);
        font-weight: 700;
        font-size: 0.88rem;
        border: 1px solid rgba(59, 130, 246, 0.12);
        margin-bottom: 18px;
    }

    .auth-header h1 {
        margin: 0 0 10px;
        color: var(--text);
        font-size: clamp(2rem, 3vw, 2.8rem);
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .auth-header p {
        max-width: 720px;
        margin: 0 auto;
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.7;
    }

    .auth-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 0;
        align-items: stretch;
        padding: 24px;
    }

    .auth-main,
    .auth-side {
        padding: 12px;
    }

    .auth-main {
        display: flex;
        align-items: stretch;
    }

        .auth-main form,
        .auth-side-card {
            width: 100%;
            background: var(--card);
            border: 1px solid var(--border-soft);
            border-radius: 22px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        }

        .auth-main form {
            padding: 28px;
        }

    .auth-side-card {
        padding: 28px;
        height: 100%;
    }

        .auth-side-card h3 {
            margin: 0 0 10px;
            font-size: 1.25rem;
            color: var(--text);
            font-weight: 700;
        }

        .auth-side-card p {
            margin: 0 0 18px;
            color: var(--text-secondary);
            line-height: 1.65;
        }

    .auth-field {
        margin-bottom: 18px;
    }

        .auth-field label {
            display: block;
            margin-bottom: 8px;
            color: var(--text);
            font-weight: 600;
            font-size: 0.95rem;
        }

    .auth-input {
        width: 100%;
        min-height: 52px;
        padding: 0 16px;
        border-radius: 16px;
        border: 1px solid rgba(148, 163, 184, 0.28);
        background: #fff;
        color: var(--text);
        font-size: 0.98rem;
        outline: none;
        transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
    }

        .auth-input:focus {
            border-color: rgba(59, 130, 246, 0.45);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.10);
        }

        .auth-input::placeholder {
            color: #94A3B8;
        }

    .auth-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin: 14px 0 22px;
        flex-wrap: wrap;
    }

    .remember-me {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-secondary);
        font-weight: 500;
        cursor: pointer;
    }

        .remember-me input {
            width: 18px;
            height: 18px;
            accent-color: var(--primary);
        }

    .auth-submit-btn {
        width: 100%;
        min-height: 54px;
        border: none;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        font-size: 1rem;
        font-weight: 700;
        box-shadow: 0 14px 28px rgba(59, 130, 246, 0.18);
        transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.22s ease;
    }

        .auth-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 34px rgba(59, 130, 246, 0.24);
        }

        .auth-submit-btn:active {
            transform: translateY(0);
        }

    .auth-extra-links {
        margin-top: 22px;
        text-align: center;
    }

        .auth-extra-links p {
            margin: 10px 0 0;
            color: var(--text-secondary);
        }

    .auth-link {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease, opacity 0.2s ease;
    }

        .auth-link:hover {
            color: var(--secondary);
        }

    .subtle-link {
        color: var(--text-secondary);
    }

        .subtle-link:hover {
            color: var(--primary);
        }

    .validation-summary {
        margin-bottom: 18px;
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.16);
        color: #B91C1C;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

    .field-validation {
        display: block;
        margin-top: 7px;
        color: #DC2626;
        font-size: 0.88rem;
    }

    .external-empty {
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(59, 130, 246, 0.05);
        border: 1px solid rgba(59, 130, 246, 0.10);
    }

    .external-form {
        margin: 0;
    }

    .external-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .external-btn {
        width: 100%;
        min-height: 48px;
        padding: 12px 16px;
        border-radius: 14px;
        border: 1px solid rgba(148, 163, 184, 0.22);
        background: #fff;
        color: var(--text);
        font-weight: 600;
        transition: all 0.22s ease;
    }

        .external-btn:hover {
            border-color: rgba(59, 130, 246, 0.22);
            box-shadow: var(--shadow-hover);
            transform: translateY(-1px);
            color: var(--primary);
        }

    @@media (max-width: 991.98px) {
        .auth-grid {
            grid-template-columns: 1fr;
            padding: 18px;
        }

        .auth-header {
            padding: 30px 24px 8px;
        }
    }

    @@media (max-width: 767.98px) {
        .auth-page {
            padding: 20px 10px;
            min-height: auto;
        }

        .auth-header h1 {
            font-size: 1.9rem;
        }

        .auth-header,
        .auth-main form,
        .auth-side-card {
            padding-left: 20px;
            padding-right: 20px;
        }

        .auth-options {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .auth-input,
        .auth-submit-btn,
        .auth-link,
        .external-btn {
            transition: none !important;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model PrivacyModel
@{
    ViewData["Title"] = "Acerca de";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="p-4 p-md-5 rounded-4 shadow-sm border bg-white" style="background:rgba(255,255,255,.85); backdrop-filter: blur(10px);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:44px;height:44px;border-radius:16px;background:linear-gradient(180deg,#49b7ff,#2aa6ff);display:flex;align-items:center;justify-content:center;color:white;font-weight:800;">
                    S
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-0">Sounds</h1>
                    <div class="text-muted small">Chats, grupos y llamadas de voz</div>
                </div>
            </div>

            <hr class="my-4" />

            <h2 class="h5 fw-semibold">Qué es</h2>
            <p class="text-muted mb-4">
                Sounds es una app web donde puedes crear grupos, unirte por código y hablar con otros usuarios.
            </p>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded-4 border" style="background:rgba(73,183,255,.08);">
                        <div class="fw-semibold">Grupos</div>
                        <div class="text-muted small">Crea y organiza salas por temática.</div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded-4 border" style="background:rgba(73,183,255,.08);">
                        <div class="fw-semibold">Llamadas</div>
                        <div class="text-muted small">Audio en tiempo real dentro del grupo.</div>
                    </div>
                </div>
            </div>

            <div class="mt-4 small text-muted">
                 2026 Sounds. Esta página puede usarse también para tu política de privacidad si la necesitas.
            </div>
        </div>
    </div>
</div>
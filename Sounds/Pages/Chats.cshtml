<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    // ================================================================
    //  SOUNDS — Chats con WebRTC mesh + SignalR
    // ================================================================

    const ME = "@(User.Identity?.Name ?? "Yo")";

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/callhub")
        .withAutomaticReconnect()
        .build();

    const ICE = { iceServers: [{ urls: "stun:stun.l.google.com:19302" }] };

    // ── Estado global ──
    let currentGroup   = null;
    let currentGroupName = "";
    let localStream    = null;
    let cameraStream   = null;
    let screenStream   = null;
    let micMuted       = false;
    let deafened       = false;
    let cameraOn       = false;
    let screenSharing  = false;

    // expandedState = { connId, type } donde type = 'camera' | 'screen'
    let expandedState  = null;

    // Mapa de peers: connId → { pc, username, audioEl, videoStream, screenStream }
    const peers = {};

    // ================================================================
    //  CARGA DE GRUPOS
    // ================================================================
    async function loadGroups() {
        try {
            const res = await fetch('/api/grupos');
            if (!res.ok) return;
            const grupos = await res.json();
            renderGroups(grupos);
        } catch (e) { console.error(e); }
    }

    function renderGroups(grupos) {
        const list = document.getElementById('gruposList');
        if (!grupos.length) {
            list.innerHTML = '<div class="groups-loading">Sin grupos. Ve a Grupos para crear uno.</div>';
            return;
        }
        list.innerHTML = grupos.map(g => `
            <div class="group-item" data-code="${esc(g.code)}" data-name="${esc(g.name)}" onclick="selectGroup(this)">
                <div class="group-av">${(g.name||'G')[0].toUpperCase()}</div>
                <div class="group-info">
                    <div class="group-iname">${esc(g.name)}</div>
                    <div class="group-icode">Código: ${esc(g.code)}</div>
                </div>
                <div class="group-dot"></div>
            </div>
        `).join('');
    }

    async function selectGroup(el) {
        const code = el.dataset.code;
        const name = el.dataset.name;
        if (currentGroup === code) return;
        document.querySelectorAll('.group-item').forEach(i => i.classList.remove('active'));
        el.classList.add('active');
        await switchGroup(code, name);
    }

    // ================================================================
    //  SWITCH DE GRUPO
    // ================================================================
    async function switchGroup(code, name) {
        if (currentGroup) {
            await connection.invoke('LeaveCall', currentGroup).catch(() => {});
            stopAllMedia();
            destroyAllPeers();
        }

        currentGroup     = code;
        currentGroupName = name;

        document.getElementById('emptyState').style.display  = 'none';
        document.getElementById('roomWrap').style.display    = 'flex';
        document.getElementById('roomAvatar').textContent    = (name||'G')[0].toUpperCase();
        document.getElementById('roomName').textContent      = name;
        document.getElementById('roomStatus').textContent    = 'Conectando...';

        collapseExpandedView();
        clearParticipantsGrid();
        clearChat();

        addOrUpdateTile('__me__', ME, true);

        try {
            localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
            micMuted = false;
            updateMicBtn();
            await connection.invoke('JoinCall', code);
            document.getElementById('roomStatus').textContent = 'Conectado';
            const history = await connection.invoke('GetChatHistory', code, 50);
            history.forEach(m => appendMessage(m));
        } catch (e) {
            appendSystemMsg('⚠️ No se pudo acceder al micrófono: ' + e.message);
            await connection.invoke('JoinCall', code).catch(() => {});
            document.getElementById('roomStatus').textContent = 'Conectado (sin audio)';
            const history = await connection.invoke('GetChatHistory', code, 50).catch(() => []);
            history.forEach(m => appendMessage(m));
        }
    }

    // ================================================================
    //  SIGNALR EVENTOS
    // ================================================================

    connection.on('ExistingPeers', async (peers_list) => {
        for (const peer of peers_list) {
            addOrUpdateTile(peer.connId, peer.username, false);
            await createPeerAndOffer(peer.connId, peer.username);
        }
    });

    connection.on('PeerJoined', ({ connId, username }) => {
        addOrUpdateTile(connId, username, false);
        appendSystemMsg(`${username} se ha unido.`);
    });

    connection.on('ReceiveOffer', async (fromConnId, fromUsername, offerJson) => {
        addOrUpdateTile(fromConnId, fromUsername, false);
        const pc = getOrCreatePC(fromConnId, fromUsername);
        await pc.setRemoteDescription(JSON.parse(offerJson));
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        await connection.invoke('SendAnswer', fromConnId, JSON.stringify(answer));
    });

    connection.on('PeerLeft', (connId) => {
        const peer = peers[connId];
        if (peer) {
            if (expandedState && expandedState.connId === connId) {
                collapseExpandedView();
            }
            peer.pc.close();
            removeTile(connId);
            removeMiniTile(connId);
            appendSystemMsg(`${peer.username} ha salido.`);
            delete peers[connId];
        }
    });

    connection.on('CallUsersUpdated', (usernames) => { /* gestionado via tiles */ });

    connection.on('ReceiveAnswer', async (fromConnId, answerJson) => {
        const entry = peers[fromConnId];
        if (!entry) return;
        await entry.pc.setRemoteDescription(JSON.parse(answerJson));
    });

    connection.on('ReceiveIceCandidate', async (fromConnId, candJson) => {
        const entry = peers[fromConnId];
        if (!entry) return;
        try { await entry.pc.addIceCandidate(JSON.parse(candJson)); } catch {}
    });

    connection.on('ReceiveMessage', (msg) => appendMessage(msg));

    // ================================================================
    //  WEBRTC
    // ================================================================

    async function createPeerAndOffer(targetConnId, username) {
        const pc = getOrCreatePC(targetConnId, username);
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        await connection.invoke('SendOffer', targetConnId, JSON.stringify(offer));
    }

    function getOrCreatePC(connId, username) {
        if (peers[connId]) return peers[connId].pc;

        const pc = new RTCPeerConnection(ICE);

        if (localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));
        if (cameraStream) cameraStream.getTracks().forEach(t => pc.addTrack(t, cameraStream));
        if (screenStream) screenStream.getTracks().forEach(t => pc.addTrack(t, screenStream));

        pc.onicecandidate = (ev) => {
            if (ev.candidate)
                connection.invoke('SendIceCandidate', connId, JSON.stringify(ev.candidate)).catch(() => {});
        };

        pc.ontrack = (ev) => {
            const stream = ev.streams[0];
            const track  = ev.track;

            if (track.kind === 'audio') {
                const audio = new Audio();
                audio.srcObject = stream;
                audio.autoplay  = true;
                if (deafened) audio.muted = true;
                peers[connId].audioEl = audio;
            }

            if (track.kind === 'video') {
                const isScreen = track.label.toLowerCase().includes('screen') ||
                                 track.label.toLowerCase().includes('display') ||
                                 track.label.toLowerCase().includes('monitor') ||
                                 (ev.streams.length > 1);

                if (isScreen) {
                    peers[connId].screenStream = stream;
                    const tile = document.getElementById('tile-' + connId);
                    if (tile) tile.classList.add('has-screen');

                    // Detectar cuando el peer deja de compartir pantalla
                    track.addEventListener('ended', () => {
                        onRemotePeerStopsScreen(connId);
                    });

                    if (!expandedState) {
                        showRemoteScreenOverlay(stream, peers[connId]?.username || username);
                    }
                } else {
                    peers[connId].videoStream = stream;
                    attachVideoToTile(connId, stream);

                    // Detectar cuando el peer apaga la cámara
                    track.addEventListener('ended', () => {
                        onRemotePeerStopsCamera(connId);
                    });
                }

                // Si este peer ya está expandido, refrescar el vídeo principal
                if (expandedState && expandedState.connId === connId) {
                    refreshExpandedVideo();
                }
            }
        };

        peers[connId] = { pc, username, audioEl: null, videoStream: null, screenStream: null };
        return pc;
    }

    function destroyAllPeers() {
        for (const [id, entry] of Object.entries(peers)) {
            entry.pc.close();
            if (entry.audioEl) entry.audioEl.pause();
        }
        Object.keys(peers).forEach(k => delete peers[k]);
    }

    // ================================================================
    //  TILES DE PARTICIPANTES
    // ================================================================

    function addOrUpdateTile(id, username, isMe) {
        if (document.getElementById('tile-' + id)) return;

        const grid    = document.getElementById('participantsGrid');
        const tile    = document.createElement('div');
        const initial = (username||'?')[0].toUpperCase();

        tile.className = 'peer-tile' + (isMe ? ' is-me' : '');
        tile.id        = 'tile-' + id;

        tile.innerHTML = `
            <div class="peer-avatar-big">${esc(initial)}</div>
            <video autoplay playsinline ${isMe ? 'muted' : ''}></video>
            <div class="peer-name-label">${esc(username)}${isMe ? ' (Tú)' : ''}</div>
            <div class="peer-icons">
                ${isMe ? '<span class="peer-icon" id="icon-mic-me">🎤</span>' : ''}
            </div>
            <div class="peer-tile-expand-hint">
                <svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                Ampliar
            </div>
        `;

        // Click para ampliar (solo actúa si tiene vídeo o pantalla)
        tile.addEventListener('click', () => onTileClick(id, username));

        grid.appendChild(tile);
        updateGridLayout();
    }

    function removeTile(id) {
        const tile = document.getElementById('tile-' + id);
        if (tile) tile.remove();
        updateGridLayout();
    }

    function clearParticipantsGrid() {
        document.getElementById('participantsGrid').innerHTML = '';
        updateGridLayout();
    }

    function updateGridLayout() {
        const grid  = document.getElementById('participantsGrid');
        const count = grid.children.length;
        grid.className = 'participants-grid';
        if (count === 1)      grid.classList.add('count-1');
        else if (count === 2) grid.classList.add('count-2');
        else if (count <= 4)  grid.classList.add('count-3');
        else                  grid.classList.add('count-many');
    }

    function attachVideoToTile(connId, stream) {
        const tile = document.getElementById('tile-' + connId);
        if (!tile) return;
        const video = tile.querySelector('video');
        if (!video) return;
        video.srcObject = stream;
        tile.classList.add('has-video');
        tile.querySelector('.peer-avatar-big').style.display = 'none';
    }

    function attachMyCamera(stream) {
        const tile = document.getElementById('tile-__me__');
        if (!tile) return;
        const video = tile.querySelector('video');
        if (!video) return;
        video.srcObject = stream;
        tile.classList.add('has-video');
        tile.querySelector('.peer-avatar-big').style.display = 'none';
    }

    function detachMyCamera() {
        const tile = document.getElementById('tile-__me__');
        if (!tile) return;
        const video = tile.querySelector('video');
        if (video) video.srcObject = null;
        tile.classList.remove('has-video');
        const av = tile.querySelector('.peer-avatar-big');
        if (av) av.style.display = '';

        if (expandedState && expandedState.connId === '__me__') {
            collapseExpandedView();
        }
    }

    function showRemoteScreenOverlay(stream, username) {
        const area  = document.getElementById('screenShareArea');
        const video = document.getElementById('screenShareVideo');
        const label = document.getElementById('screenShareLabel');
        video.srcObject   = stream;
        label.textContent = `Pantalla de ${username}`;
        area.style.display = 'flex';
    }

    function hideRemoteScreenOverlay() {
        document.getElementById('screenShareArea').style.display = 'none';
        document.getElementById('screenShareVideo').srcObject = null;
    }

    // ================================================================
    //  VISTA EXPANDIDA
    // ================================================================

    function onTileClick(connId, username) {
        const tile = document.getElementById('tile-' + connId);
        if (!tile) return;

        const hasVideo  = tile.classList.contains('has-video');
        const hasScreen = tile.classList.contains('has-screen');
        if (!hasVideo && !hasScreen) return;

        // Toggle: si ya está expandido, colapsar
        if (expandedState && expandedState.connId === connId) {
            collapseExpandedView();
            return;
        }

        // Pantalla tiene prioridad sobre cámara
        const type = hasScreen ? 'screen' : 'camera';
        expandTile(connId, username, type);
    }

    function expandTile(connId, username, type) {
        expandedState = { connId, type };

        hideRemoteScreenOverlay();

        document.getElementById('expandedView').style.display     = 'flex';
        document.getElementById('participantsGrid').style.display = 'none';
        document.getElementById('screenShareArea').style.display  = 'none';

        refreshExpandedVideo();
        buildExpandedSidebar();
    }

    function refreshExpandedVideo() {
        if (!expandedState) return;
        const { connId, type } = expandedState;

        const expandedVideo = document.getElementById('expandedVideo');
        const expandedLabel = document.getElementById('expandedLabel');

        let stream   = null;
        let labelTxt = '';

        if (connId === '__me__') {
            if (type === 'camera' && cameraStream) {
                stream   = cameraStream;
                labelTxt = `${ME} (Tú) — Cámara`;
            } else if (type === 'screen' && screenStream) {
                stream   = screenStream;
                labelTxt = `${ME} (Tú) — Pantalla`;
            }
        } else {
            const entry = peers[connId];
            if (!entry) return;
            if (type === 'screen' && entry.screenStream) {
                stream   = entry.screenStream;
                labelTxt = `${entry.username} — Pantalla`;
            } else if (type === 'camera' && entry.videoStream) {
                stream   = entry.videoStream;
                labelTxt = `${entry.username} — Cámara`;
            }
        }

        if (stream) {
            expandedVideo.srcObject   = stream;
            expandedLabel.textContent = labelTxt;
        }
    }

    function buildExpandedSidebar() {
        const sidebar = document.getElementById('expandedSidebar');
        sidebar.innerHTML = '';

        addMiniTile('__me__', ME, true);

        for (const [connId, entry] of Object.entries(peers)) {
            addMiniTile(connId, entry.username, false);
        }
    }

    function addMiniTile(connId, username, isMe) {
        const sidebar = document.getElementById('expandedSidebar');
        if (document.getElementById('mini-' + connId)) return;

        const div     = document.createElement('div');
        const initial = (username||'?')[0].toUpperCase();
        div.className = 'mini-tile';
        div.id        = 'mini-' + connId;

        if (expandedState && expandedState.connId === connId) {
            div.classList.add('is-active-expanded');
        }

        div.innerHTML = `
            <div class="mini-avatar">${esc(initial)}</div>
            <div class="mini-name">${esc(username)}${isMe ? ' (Tú)' : ''}</div>
        `;

        const stream = getMiniStream(connId, isMe);
        if (stream) {
            const vid       = document.createElement('video');
            vid.srcObject   = stream;
            vid.autoplay    = true;
            vid.playsInline = true;
            vid.muted       = true;
            vid.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;';
            div.querySelector('.mini-avatar').style.display = 'none';
            div.appendChild(vid);
        }

        div.addEventListener('click', () => {
            if (connId === '__me__') {
                const type = (cameraOn && cameraStream) ? 'camera' : null;
                if (!type) return;
                expandedState = { connId: '__me__', type };
            } else {
                const entry = peers[connId];
                if (!entry) return;
                const type = entry.screenStream ? 'screen' : (entry.videoStream ? 'camera' : null);
                if (!type) return;
                expandedState = { connId, type };
            }
            document.querySelectorAll('.mini-tile').forEach(m => m.classList.remove('is-active-expanded'));
            div.classList.add('is-active-expanded');
            refreshExpandedVideo();
        });

        sidebar.appendChild(div);
    }

    function removeMiniTile(connId) {
        const el = document.getElementById('mini-' + connId);
        if (el) el.remove();
    }

    function getMiniStream(connId, isMe) {
        if (isMe) return cameraStream || screenStream || null;
        const entry = peers[connId];
        if (!entry) return null;
        return entry.videoStream || entry.screenStream || null;
    }

    function collapseExpandedView() {
        expandedState = null;

        document.getElementById('expandedView').style.display      = 'none';
        document.getElementById('participantsGrid').style.display  = '';
        document.getElementById('expandedSidebar').innerHTML       = '';

        const ev = document.getElementById('expandedVideo');
        if (ev) ev.srcObject = null;

        // Si hay pantalla remota activa, volver a mostrar overlay
        for (const [connId, entry] of Object.entries(peers)) {
            if (entry.screenStream) {
                showRemoteScreenOverlay(entry.screenStream, entry.username);
                break;
            }
        }
    }

    // ================================================================
    //  PANTALLA COMPLETA
    // ================================================================

    function enterFullscreen() {
        const container = document.getElementById('expandedMain');
        if (!container) return;
        try {
            if (container.requestFullscreen)            container.requestFullscreen().catch(e => console.warn('Fullscreen:', e.message));
            else if (container.webkitRequestFullscreen) container.webkitRequestFullscreen();
            else if (container.mozRequestFullScreen)    container.mozRequestFullScreen();
            else if (container.msRequestFullscreen)     container.msRequestFullscreen();
        } catch (e) { console.warn('Fullscreen no disponible:', e); }
    }

    // ================================================================
    //  GESTIÓN: PEER DEJA CÁMARA O PANTALLA
    // ================================================================

    function onRemotePeerStopsCamera(connId) {
        const entry = peers[connId];
        if (!entry) return;
        entry.videoStream = null;

        const tile = document.getElementById('tile-' + connId);
        if (tile) {
            tile.classList.remove('has-video');
            const video = tile.querySelector('video');
            if (video) video.srcObject = null;
            const av = tile.querySelector('.peer-avatar-big');
            if (av) av.style.display = '';
        }

        if (expandedState && expandedState.connId === connId && expandedState.type === 'camera') {
            if (entry.screenStream) {
                expandedState.type = 'screen';
                refreshExpandedVideo();
                buildExpandedSidebar();
            } else {
                collapseExpandedView();
            }
        }

        removeMiniTile(connId);
        addMiniTile(connId, entry.username, false);
    }

    function onRemotePeerStopsScreen(connId) {
        const entry = peers[connId];
        if (!entry) return;
        entry.screenStream = null;

        const tile = document.getElementById('tile-' + connId);
        if (tile) tile.classList.remove('has-screen');

        hideRemoteScreenOverlay();

        if (expandedState && expandedState.connId === connId && expandedState.type === 'screen') {
            if (entry.videoStream) {
                expandedState.type = 'camera';
                refreshExpandedVideo();
                buildExpandedSidebar();
            } else {
                collapseExpandedView();
            }
        }

        removeMiniTile(connId);
        addMiniTile(connId, entry.username, false);
    }

    // ================================================================
    //  CONTROLES
    // ================================================================

    function updateMicBtn() {
        const btn = document.getElementById('btnMute');
        if (!btn) return;
        if (micMuted) {
            btn.classList.add('muted');
            btn.querySelector('span').textContent = 'Silenciado';
            const ic = document.getElementById('icon-mic-me');
            if (ic) ic.textContent = '🔇';
        } else {
            btn.classList.remove('muted');
            btn.querySelector('span').textContent = 'Micro';
            const ic = document.getElementById('icon-mic-me');
            if (ic) ic.textContent = '🎤';
        }
    }

    document.getElementById('btnMute').addEventListener('click', () => {
        const track = localStream?.getAudioTracks?.()[0];
        if (!track) return;
        micMuted = !micMuted;
        track.enabled = !micMuted;
        updateMicBtn();
    });

    document.getElementById('btnDeafen').addEventListener('click', () => {
        deafened = !deafened;
        const btn = document.getElementById('btnDeafen');
        for (const entry of Object.values(peers)) {
            if (entry.audioEl) entry.audioEl.muted = deafened;
        }
        if (deafened) { btn.classList.add('muted'); btn.querySelector('span').textContent = 'Ensordecido'; }
        else          { btn.classList.remove('muted'); btn.querySelector('span').textContent = 'Sonido'; }
    });

    document.getElementById('btnHangup').addEventListener('click', async () => {
        if (!currentGroup) return;
        await connection.invoke('LeaveCall', currentGroup).catch(() => {});
        stopAllMedia();
        destroyAllPeers();
        currentGroup = null;
        collapseExpandedView();
        document.querySelectorAll('.group-item').forEach(i => i.classList.remove('active'));
        document.getElementById('roomWrap').style.display   = 'none';
        document.getElementById('emptyState').style.display = 'flex';
        clearParticipantsGrid();
    });

    document.getElementById('btnCamera').addEventListener('click', async () => {
        if (cameraOn) {
            cameraStream?.getTracks().forEach(t => t.stop());
            cameraStream = null;
            cameraOn     = false;
            detachMyCamera();
            removeCameraFromPeers();
            document.getElementById('btnCamera').classList.remove('active');
            document.querySelector('#btnCamera span').textContent = 'Cámara';

            if (expandedState && expandedState.connId === '__me__' && expandedState.type === 'camera') {
                collapseExpandedView();
            }
        } else {
            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                cameraOn     = true;
                attachMyCamera(cameraStream);
                addCameraToPeers(cameraStream);
                document.getElementById('btnCamera').classList.add('active');
                document.querySelector('#btnCamera span').textContent = 'Cámara ON';

                if (expandedState) {
                    removeMiniTile('__me__');
                    addMiniTile('__me__', ME, true);
                }
            } catch (e) {
                appendSystemMsg('⚠️ No se pudo acceder a la cámara.');
            }
        }
    });

    document.getElementById('btnScreen').addEventListener('click', async () => {
        if (screenSharing) {
            screenStream?.getTracks().forEach(t => t.stop());
            screenStream  = null;
            screenSharing = false;
            removeScreenFromPeers();
            document.getElementById('screenShareArea').style.display = 'none';
            document.getElementById('btnScreen').classList.remove('active');
            document.querySelector('#btnScreen span').textContent = 'Pantalla';

            if (expandedState && expandedState.connId === '__me__' && expandedState.type === 'screen') {
                if (cameraOn && cameraStream) {
                    expandedState.type = 'camera';
                    refreshExpandedVideo();
                } else {
                    collapseExpandedView();
                }
            }
        } else {
            try {
                screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: false });
                screenSharing = true;

                if (!expandedState) {
                    const area  = document.getElementById('screenShareArea');
                    const video = document.getElementById('screenShareVideo');
                    video.srcObject = screenStream;
                    document.getElementById('screenShareLabel').textContent = 'Tu pantalla compartida';
                    area.style.display = 'flex';
                }

                addScreenToPeers(screenStream);
                document.getElementById('btnScreen').classList.add('active');
                document.querySelector('#btnScreen span').textContent = 'Detener';

                const myTile = document.getElementById('tile-__me__');
                if (myTile) myTile.classList.add('has-screen');

                screenStream.getVideoTracks()[0].addEventListener('ended', () => {
                    document.getElementById('btnScreen').click();
                });

                if (expandedState) {
                    removeMiniTile('__me__');
                    addMiniTile('__me__', ME, true);
                }
            } catch (e) {
                if (e.name !== 'NotAllowedError')
                    appendSystemMsg('⚠️ No se pudo compartir pantalla: ' + e.message);
            }
        }
    });

    // ================================================================
    //  AÑADIR/QUITAR TRACKS A PEERS (renegociación)
    // ================================================================

    async function addCameraToPeers(stream) {
        for (const [connId, entry] of Object.entries(peers)) {
            stream.getVideoTracks().forEach(t => entry.pc.addTrack(t, stream));
            await renegotiate(connId, entry);
        }
    }

    function removeCameraFromPeers() {
        for (const entry of Object.values(peers)) {
            entry.pc.getSenders()
                .filter(s => s.track?.kind === 'video' && !isScreenTrack(s.track))
                .forEach(s => entry.pc.removeTrack(s));
        }
    }

    async function addScreenToPeers(stream) {
        for (const [connId, entry] of Object.entries(peers)) {
            stream.getVideoTracks().forEach(t => entry.pc.addTrack(t, stream));
            await renegotiate(connId, entry);
        }
    }

    function removeScreenFromPeers() {
        for (const entry of Object.values(peers)) {
            entry.pc.getSenders()
                .filter(s => isScreenTrack(s.track))
                .forEach(s => entry.pc.removeTrack(s));
        }
    }

    function isScreenTrack(track) {
        if (!track) return false;
        const lbl = track.label.toLowerCase();
        return lbl.includes('screen') || lbl.includes('display') || lbl.includes('monitor');
    }

    async function renegotiate(connId, entry) {
        try {
            const offer = await entry.pc.createOffer();
            await entry.pc.setLocalDescription(offer);
            await connection.invoke('SendOffer', connId, JSON.stringify(offer));
        } catch (e) { console.error('Renegotiate error', e); }
    }

    function stopAllMedia() {
        localStream?.getTracks().forEach(t => t.stop());  localStream  = null;
        cameraStream?.getTracks().forEach(t => t.stop()); cameraStream = null;
        screenStream?.getTracks().forEach(t => t.stop()); screenStream = null;
        cameraOn = false; screenSharing = false; micMuted = false; deafened = false;

        document.getElementById('btnCamera').classList.remove('active');
        document.querySelector('#btnCamera span').textContent = 'Cámara';
        document.getElementById('btnScreen').classList.remove('active');
        document.querySelector('#btnScreen span').textContent = 'Pantalla';
        document.getElementById('screenShareArea').style.display = 'none';
        updateMicBtn();
    }

    // ================================================================
    //  CHAT
    // ================================================================

    function clearChat() {
        document.getElementById('chatMessages').innerHTML = '';
    }

    function appendMessage({ user, text, time }) {
        const box     = document.getElementById('chatMessages');
        const row     = document.createElement('div');
        row.className = 'msg-row';
        const initial = (user||'?')[0].toUpperCase();
        row.innerHTML = `
            <div class="msg-av">${esc(initial)}</div>
            <div class="msg-bubble">
                <div class="msg-meta">
                    <span class="msg-user">${esc(user)}</span>
                    <span class="msg-time">${esc(time)}</span>
                </div>
                <div class="msg-text">${esc(text)}</div>
            </div>`;
        box.appendChild(row);
        box.scrollTop = box.scrollHeight;
    }

    function appendSystemMsg(text) {
        const box      = document.getElementById('chatMessages');
        const el       = document.createElement('div');
        el.className   = 'msg-system';
        el.textContent = text;
        box.appendChild(el);
        box.scrollTop  = box.scrollHeight;
    }

    async function sendMessage() {
        const input = document.getElementById('chatInput');
        const text  = (input.value || '').trim();
        if (!text || !currentGroup) return;
        try {
            await connection.invoke('SendMessage', currentGroup, text);
            input.value = '';
            input.focus();
        } catch { appendSystemMsg('❌ Error al enviar.'); }
    }

    document.getElementById('btnSend').addEventListener('click', sendMessage);
    document.getElementById('chatInput').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); sendMessage(); }
    });

    // ================================================================
    //  UTILS
    // ================================================================

    function esc(str) {
        const d = document.createElement('div');
        d.textContent = str ?? '';
        return d.innerHTML;
    }

    // ================================================================
    //  INICIO
    // ================================================================

    async function start() {
        try {
            await connection.start();
            await loadGroups();
        } catch (e) { console.error('SignalR error:', e); }
    }

    start();
</script>
@page
@model Sounds.Pages.ChatsModel

<div class="chats-shell">

    <!-- SIDEBAR IZQUIERDA: Lista de grupos -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-title">Chats</span>
        </div>

        <div class="groups-list" id="gruposList">
            <div class="groups-loading">Cargando...</div>
        </div>

        <div class="sidebar-footer-btn">
            <button class="translate-btn" type="button">
                <svg viewBox="0 0 24 24"><path d="M12.87 15.07l-2.54-2.51.03-.03A17.516 17.516 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17A15.9 15.9 0 0 1 9.5 10.58 15.91 15.91 0 0 1 7.74 8H5.74a17.502 17.502 0 0 0 2.6 3.53L3 16.9 4.41 18.3 9.5 13.22l3.16 3.16.21-.21zM18.5 10h-2l-4.5 12h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.63 7l1.63-4.33L19.13 17h-3.26z" /></svg>
                <span class="translate-label">Traducción en tiempo real<small>Próximamente</small></span>
            </button>
        </div>
    </aside>

    <!-- PANEL PRINCIPAL -->
    <main class="main-panel">

        <!-- Estado vacío -->
        <div class="empty-state" id="emptyState">
            <div class="empty-icon">
                <svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5.3-3a5.3 5.3 0 0 1-10.6 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-1.7z" /></svg>
            </div>
            <h2>Selecciona un grupo</h2>
            <p>Elige un grupo de la izquierda para entrar en llamada y chat.</p>
        </div>

        <!-- Sala activa -->
        <div class="room-wrap" id="roomWrap" style="display:none;">

            <!-- Header del grupo activo -->
            <div class="room-header">
                <div class="room-header-left">
                    <div class="room-avatar" id="roomAvatar">?</div>
                    <div>
                        <div class="room-name" id="roomName">Grupo</div>
                        <div class="room-status" id="roomStatus">Conectando...</div>
                    </div>
                </div>
                <div class="live-badge"><span class="live-dot"></span>En directo</div>
            </div>

            <div class="room-body">

                <!-- Área de video/participantes -->
                <div class="video-area" id="videoArea">

                    <!--
                        VISTA AMPLIADA: se muestra cuando el usuario hace click en un tile con vídeo.
                        Contiene el vídeo principal (grande) y una barra lateral con el resto de tiles.
                    -->
                    <div class="expanded-view" id="expandedView" style="display:none;">
                        <!-- Vídeo/pantalla ampliada -->
                        <div class="expanded-main" id="expandedMain">
                            <video id="expandedVideo" autoplay playsinline></video>
                            <div class="expanded-label" id="expandedLabel">Usuario</div>

                            <!-- Botón pantalla completa -->
                            <button class="btn-fullscreen" id="btnFullscreen" title="Pantalla completa" onclick="enterFullscreen()">
                                <svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" /></svg>
                                Pantalla completa
                            </button>

                            <!-- Botón cerrar vista ampliada -->
                            <button class="btn-collapse" id="btnCollapse" title="Cerrar vista ampliada" onclick="collapseExpandedView()">
                                <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
                            </button>
                        </div>

                        <!-- Tira lateral con el resto de participantes -->
                        <div class="expanded-sidebar" id="expandedSidebar">
                            <!-- Se rellena dinámicamente con miniaturas -->
                        </div>
                    </div>

                    <!-- Grid normal de participantes (visible cuando NO hay vista ampliada) -->
                    <div class="participants-grid" id="participantsGrid">
                        <!-- Se genera dinámicamente -->
                    </div>

                    <!-- Pantalla compartida remota (overlay cuando no hay vista ampliada) -->
                    <div class="screen-share-area" id="screenShareArea" style="display:none;">
                        <video id="screenShareVideo" autoplay playsinline></video>
                        <div class="screen-share-label" id="screenShareLabel">Pantalla compartida</div>
                    </div>
                </div>

                <!-- Panel de chat -->
                <div class="chat-panel">
                    <div class="chat-panel-header">
                        <span class="chat-panel-title">Chat del grupo</span>
                        <span class="chat-dot-status"><span class="cdot"></span>Conectado</span>
                    </div>
                    <div class="chat-messages" id="chatMessages"></div>
                    <div class="chat-input-row">
                        <input id="chatInput" type="text" placeholder="Escribe un mensaje…" maxlength="500" autocomplete="off" />
                        <button id="btnSend" type="button">
                            <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                        </button>
                    </div>
                </div>

            </div>

            <!-- Barra de controles -->
            <div class="controls-bar">
                <button id="btnMute" class="ctrl-btn" title="Micrófono">
                    <svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5.3-3a5.3 5.3 0 0 1-10.6 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-1.7z" /></svg>
                    <span>Micro</span>
                </button>

                <button id="btnDeafen" class="ctrl-btn" title="Sonido">
                    <svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z" /></svg>
                    <span>Sonido</span>
                </button>

                <button id="btnHangup" class="ctrl-btn ctrl-danger" title="Colgar">
                    <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.15 6.59 6.59l2.2-2.2c.28-.28.67-.36 1.02-.25 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    <span>Colgar</span>
                </button>

                <button id="btnCamera" class="ctrl-btn" title="Cámara">
                    <svg viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z" /></svg>
                    <span>Cámara</span>
                </button>

                <button id="btnScreen" class="ctrl-btn" title="Compartir pantalla">
                    <svg viewBox="0 0 24 24"><path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zm-9-1v-2H4V6h16v10h-9z" /></svg>
                    <span>Pantalla</span>
                </button>
            </div>

        </div>
    </main>

    <audio id="remoteAudio" autoplay style="display:none;"></audio>
</div>

<style>
    :root {
        --bg: #0d1117;
        --bg2: #161b22;
        --bg3: #1c2128;
        --side: #13171e;
        --border: rgba(255,255,255,0.06);
        --accent: #3B82F6;
        --accent2: #6366F1;
        --text: #e6edf3;
        --text2: #8b949e;
        --success: #22C55E;
        --danger: #EF4444;
        --radius: 12px;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 14px;
    }

    .app-main,
    .app-page-wrap {
        width: 100% !important;
        max-width: none !important;
        padding: 0 !important;
        margin: 0 !important;
        overflow: hidden !important;
    }

    .chats-shell {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        width: 100%;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        background: var(--bg);
    }

    .sidebar {
        display: flex;
        flex-direction: column;
        width: 300px;
        min-width: 300px;
        max-width: 300px;
        background: var(--side);
        border-right: 1px solid var(--border);
        overflow: hidden;
    }

    .sidebar-header {
        padding: 16px 18px 12px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .sidebar-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .groups-list {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .groups-list::-webkit-scrollbar {
            width: 4px;
        }

        .groups-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.08);
            border-radius: 4px;
        }

    .group-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        transition: background 0.15s ease;
        user-select: none;
    }

        .group-item:hover {
            background: rgba(255,255,255,0.06);
        }

        .group-item.active {
            background: rgba(59,130,246,0.15);
        }

    .group-av {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .group-item.active .group-av {
        box-shadow: 0 0 0 2px var(--accent);
    }

    .group-info {
        min-width: 0;
        flex: 1;
    }

    .group-iname {
        font-weight: 600;
        color: var(--text);
        font-size: 0.92rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .group-icode {
        color: var(--text2);
        font-size: 0.78rem;
        margin-top: 2px;
    }

    .group-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--success);
        flex-shrink: 0;
        box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
    }

    .groups-loading {
        padding: 20px;
        text-align: center;
        color: var(--text2);
    }

    .sidebar-footer-btn {
        padding: 12px;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
    }

    .translate-btn {
        width: 100%;
        background: rgba(59,130,246,0.08);
        border: 1px solid rgba(59,130,246,0.14);
        border-radius: 10px;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text2);
        cursor: pointer;
        transition: background 0.15s;
    }

        .translate-btn:hover {
            background: rgba(59,130,246,0.14);
        }

        .translate-btn svg {
            width: 18px;
            height: 18px;
            fill: var(--accent);
            flex-shrink: 0;
        }

    .translate-label {
        display: flex;
        flex-direction: column;
        text-align: left;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text);
    }

        .translate-label small {
            font-weight: 400;
            color: var(--text2);
            font-size: 0.72rem;
        }

    .main-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: var(--bg);
        position: relative;
        min-width: 0;
        width: 100%;
    }

    .empty-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        color: var(--text2);
        padding: 40px;
        text-align: center;
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 24px;
        background: rgba(59,130,246,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .empty-icon svg {
            width: 36px;
            height: 36px;
            fill: var(--accent);
        }

    .empty-state h2 {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text);
    }

    .empty-state p {
        max-width: 300px;
        line-height: 1.6;
    }

    .room-wrap {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
        overflow: hidden;
        min-height: 0;
        min-width: 0;
    }

    .room-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        background: var(--bg2);
        flex-shrink: 0;
        min-height: 58px;
    }

    .room-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .room-avatar {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .room-name {
        font-weight: 700;
        font-size: 0.95rem;
    }

    .room-status {
        font-size: 0.75rem;
        color: var(--text2);
        margin-top: 2px;
    }

    .live-badge {
        display: flex;
        align-items: center;
        gap: 7px;
        background: rgba(34,197,94,0.1);
        border: 1px solid rgba(34,197,94,0.2);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #22C55E;
        flex-shrink: 0;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 0 3px rgba(34,197,94,0.2);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            box-shadow: 0 0 0 3px rgba(34,197,94,0.2);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(34,197,94,0.08);
        }
    }

    .room-body {
        flex: 1;
        min-height: 0;
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        overflow: hidden;
    }

    .video-area {
        position: relative;
        background: var(--bg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: stretch;
        padding: 14px;
        min-width: 0;
        min-height: 0;
    }

    .expanded-view {
        display: flex;
        flex-direction: row;
        width: 100%;
        height: 100%;
        overflow: hidden;
        gap: 8px;
    }

    .expanded-main {
        flex: 1;
        position: relative;
        background: #000;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
    }

        .expanded-main video {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .expanded-label {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: rgba(0,0,0,0.7);
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        backdrop-filter: blur(6px);
        pointer-events: none;
    }

    .btn-fullscreen {
        position: absolute;
        bottom: 12px;
        right: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(59,130,246,0.85);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 7px 12px;
        cursor: pointer;
        backdrop-filter: blur(6px);
        transition: background 0.15s, transform 0.1s;
        z-index: 5;
    }

        .btn-fullscreen svg {
            width: 16px;
            height: 16px;
            fill: #fff;
            flex-shrink: 0;
        }

        .btn-fullscreen:hover {
            background: rgba(37,99,235,0.95);
            transform: scale(1.04);
        }

    .btn-collapse {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        background: rgba(0,0,0,0.6);
        border: none;
        border-radius: 50%;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(6px);
        transition: background 0.15s;
        z-index: 5;
        padding: 0;
    }

        .btn-collapse svg {
            width: 16px;
            height: 16px;
            fill: #fff;
        }

        .btn-collapse:hover {
            background: rgba(239,68,68,0.7);
        }

    .expanded-sidebar {
        width: 120px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
        padding-right: 2px;
    }

        .expanded-sidebar::-webkit-scrollbar {
            width: 3px;
        }

        .expanded-sidebar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 4px;
        }

    .mini-tile {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        background: var(--bg3);
        border: 1.5px solid var(--border);
        aspect-ratio: 16/9;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: border-color 0.15s, transform 0.1s;
    }

        .mini-tile:hover {
            border-color: var(--accent);
            transform: scale(1.03);
        }

        .mini-tile.is-active-expanded {
            border-color: var(--accent);
            box-shadow: 0 0 0 2px rgba(59,130,246,0.35);
        }

        .mini-tile video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .mini-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 800;
        color: #fff;
    }

    .mini-name {
        position: absolute;
        bottom: 4px;
        left: 4px;
        right: 4px;
        background: rgba(0,0,0,0.65);
        color: #fff;
        font-size: 0.62rem;
        font-weight: 700;
        padding: 2px 5px;
        border-radius: 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        backdrop-filter: blur(4px);
    }

    .participants-grid {
        flex: 1;
        width: 100%;
        height: 100%;
        display: grid;
        gap: 12px;
        padding: 0;
        overflow-y: auto;
        min-height: 0;
    }

        .participants-grid::-webkit-scrollbar {
            width: 4px;
        }

        .participants-grid::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.08);
            border-radius: 4px;
        }

        .participants-grid.count-1 {
            grid-template-columns: minmax(0, 1fr);
            align-content: center;
            justify-content: center;
        }

        .participants-grid.count-2,
        .participants-grid.count-3,
        .participants-grid.count-4 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-content: center;
        }

        .participants-grid.count-many {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-content: start;
        }

    .peer-tile {
        position: relative;
        border-radius: 18px;
        overflow: hidden;
        background: var(--bg3);
        border: 1.5px solid var(--border);
        aspect-ratio: 16/9;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color 0.2s, transform 0.15s;
        min-height: 180px;
        width: 100%;
    }

    .participants-grid.count-1 .peer-tile {
        width: min(100%, 980px);
        margin: 0 auto;
        min-height: 320px;
    }

    .peer-tile.has-video,
    .peer-tile.has-screen {
        cursor: pointer;
    }

        .peer-tile.has-video:hover,
        .peer-tile.has-screen:hover {
            border-color: var(--accent);
            transform: scale(1.01);
        }

    .peer-tile.is-me {
        border-color: rgba(59,130,246,0.4);
    }

    .peer-tile.speaking {
        border-color: var(--success) !important;
        box-shadow: 0 0 0 2px rgba(34,197,94,0.25);
    }

    .peer-tile.has-video::after,
    .peer-tile.has-screen::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(59,130,246,0.0);
        transition: background 0.15s;
        pointer-events: none;
        border-radius: inherit;
    }

    .peer-tile.has-video:hover::after,
    .peer-tile.has-screen:hover::after {
        background: rgba(59,130,246,0.08);
    }

    .peer-tile-expand-hint {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(0,0,0,0.6);
        border-radius: 6px;
        padding: 4px 6px;
        font-size: 0.62rem;
        color: #fff;
        font-weight: 600;
        opacity: 0;
        transition: opacity 0.15s;
        pointer-events: none;
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 3px;
    }

        .peer-tile-expand-hint svg {
            width: 10px;
            height: 10px;
            fill: #fff;
        }

    .peer-tile.has-video:hover .peer-tile-expand-hint,
    .peer-tile.has-screen:hover .peer-tile-expand-hint {
        opacity: 1;
    }

    .peer-avatar-big {

@page
@model Sounds.Pages.NotasModel
@{
    ViewData["Title"] = "Notas";
}


<div class="workspace-page notes-page">
    <div class="workspace-shell">

        <!-- HEADER -->
        <section class="page-hero">
            <div>
                <span class="page-kicker">Workspace personal</span>
                <h1 class="page-title">Notas</h1>
                <p class="page-subtitle">
                    Documenta reuniones, avances y apuntes. Organiza y comparte con tu equipo.
                </p>
            </div>
            <div class="hero-actions">
                <button class="btn btn-primary-custom" onclick="abrirEditorNueva()">+ Nueva nota</button>
            </div>
        </section>

        <!-- TOOLBAR -->
        <section class="toolbar-card">
            <div class="toolbar-main">
                <div class="search-box">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"></circle>
                        <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                    <input type="text" id="searchNotas" placeholder="Buscar notas..." oninput="filtrarNotas()" />
                </div>
            </div>
        </section>

        <!-- GRID DE NOTAS -->
        <section class="notes-content">
            <div id="notasGrid" class="notes-grid">
                <div class="loading-state">Cargando notas...</div>
            </div>
        </section>

    </div>
</div>

<!-- MODAL EDITOR DE NOTA -->
<div id="modalNota" class="modal-overlay" style="display:none;" onclick="closeModalOutside(event,'modalNota')">
    <div class="modal-box modal-editor-box">
        <div class="modal-header">
            <div style="flex:1;">
                <input type="text" id="notaTitulo" class="titulo-input" placeholder="Título de la nota..." maxlength="200" />
            </div>
            <button class="modal-close" onclick="closeModal('modalNota')">✕</button>
        </div>

        <div class="editor-toolbar">
            <button onclick="fmt('bold')" title="Negrita"><b>B</b></button>
            <button onclick="fmt('italic')" title="Cursiva"><i>I</i></button>
            <button onclick="fmt('underline')" title="Subrayado"><u>U</u></button>
            <span class="sep"></span>
            <button onclick="fmtBlock('h2')" title="Título">H2</button>
            <button onclick="fmtBlock('p')" title="Párrafo">¶</button>
            <span class="sep"></span>
            <button onclick="fmt('insertUnorderedList')" title="Lista">•</button>
            <button onclick="fmt('insertOrderedList')" title="Lista numerada">1.</button>
            <span class="sep"></span>
            <button onclick="fmt('undo')" title="Deshacer">↩</button>
            <button onclick="fmt('redo')" title="Rehacer">↪</button>
        </div>

        <div id="notaEditor" class="nota-editor" contenteditable="true" spellcheck="true"
             placeholder="Escribe tus apuntes aquí..."></div>

        <div class="modal-footer">
            <div class="share-section">
                <input type="text" id="shareUsername" placeholder="Compartir con usuario..." maxlength="100" />
                <button class="btn btn-soft btn-sm" onclick="compartirNota()">Compartir</button>
            </div>
            <div class="footer-actions">
                <div id="notaError" class="nota-error" style="display:none;"></div>
                <button class="btn btn-soft" onclick="closeModal('modalNota')">Cancelar</button>
                <button class="btn btn-primary-custom" onclick="guardarNota()">Guardar nota</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL VER NOTA (solo lectura) -->
<div id="modalVerNota" class="modal-overlay" style="display:none;" onclick="closeModalOutside(event,'modalVerNota')">
    <div class="modal-box modal-ver-box">
        <div class="modal-header">
            <h2 id="verNotaTitulo" style="flex:1;margin:0;font-size:1.5rem;"></h2>
            <button class="modal-close" onclick="closeModal('modalVerNota')">✕</button>
        </div>
        <div class="modal-meta" id="verNotaMeta"></div>
        <div id="verNotaContenido" class="ver-nota-content"></div>
        <div class="modal-footer">
            <button class="btn btn-soft" onclick="closeModal('modalVerNota')">Cerrar</button>
            <button class="btn btn-primary-custom" onclick="editarDesdeVer()">Editar</button>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #3B82F6;
        --secondary: #6366F1;
        --background: #F8FAFC;
        --card: #FFFFFF;
        --text: #0F172A;
        --text-soft: #64748B;
        --success: #22C55E;
        --warning: #F59E0B;
        --error: #EF4444;
        --border: #E2E8F0;
        --shadow-sm: 0 10px 30px rgba(15,23,42,0.05);
        --shadow-md: 0 18px 40px rgba(15,23,42,0.08);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--background);
        color: var(--text);
    }

    .workspace-page {
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(59,130,246,0.08), transparent 28%), radial-gradient(circle at top right, rgba(99,102,241,0.06), transparent 24%), var(--background);
        padding: 32px 18px 48px;
    }

    .workspace-shell {
        max-width: 1380px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .page-hero, .toolbar-card, .note-card {
        background: var(--card);
        border: 1px solid rgba(226,232,240,0.9);
        box-shadow: var(--shadow-sm);
        border-radius: 24px;
    }

    .page-hero {
        padding: 32px;
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: flex-start;
    }

    .page-kicker {
        display: inline-block;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--primary);
        background: rgba(59,130,246,0.10);
        padding: 8px 12px;
        border-radius: 999px;
        margin-bottom: 16px;
    }

    .page-title {
        margin: 0 0 10px;
        font-size: clamp(2rem,2.8vw,3rem);
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .page-subtitle {
        margin: 0;
        max-width: 760px;
        color: var(--text-soft);
        font-size: 1rem;
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn {
        border: 0;
        border-radius: 14px;
        padding: 13px 18px;
        font-weight: 700;
        font-size: 0.95rem;
        transition: 0.22s ease;
        cursor: pointer;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        box-shadow: 0 10px 24px rgba(59,130,246,0.25);
    }

    .btn-soft {
        background: #F8FAFC;
        color: var(--text);
        border: 1px solid var(--border);
    }

    .btn-sm {
        padding: 10px 14px;
        font-size: 0.88rem;
        border-radius: 12px;
    }

    .btn-danger {
        background: linear-gradient(135deg, #EF4444, #DC2626);
        color: white;
    }

    .toolbar-card {
        padding: 20px 24px;
    }

    .toolbar-main {
        display: flex;
        gap: 16px;
        justify-content: space-between;
        align-items: center;
    }

    .search-box {
        position: relative;
        flex: 1;
    }

        .search-box svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: var(--text-soft);
        }

        .search-box input {
            width: 100%;
            border: 1px solid var(--border);
            background: #fff;
            border-radius: 14px;
            padding: 14px 15px 14px 44px;
            font-size: 0.96rem;
            color: var(--text);
            outline: none;
            transition: 0.2s ease;
        }

            .search-box input:focus {
                border-color: rgba(59,130,246,0.55);
                box-shadow: 0 0 0 4px rgba(59,130,246,0.10);
            }

    .notes-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 18px;
    }

    .note-card {
        padding: 22px;
        transition: 0.22s ease;
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-height: 200px;
    }

        .note-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .note-card.featured {
            background: linear-gradient(180deg, rgba(59,130,246,0.06), rgba(99,102,241,0.05)), #fff;
            border-color: rgba(59,130,246,0.18);
        }

        .note-card.shared-card {
            border-left: 4px solid var(--secondary);
        }

    .note-card-top {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: flex-start;
    }

    .note-tag {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 800;
    }

        .note-tag.blue {
            background: rgba(59,130,246,0.12);
            color: var(--primary);
        }

        .note-tag.violet {
            background: rgba(99,102,241,0.12);
            color: var(--secondary);
        }

    .note-date {
        color: var(--text-soft);
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .note-card h3 {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.4;
    }

    .note-card p {
        margin: 0;
        color: var(--text-soft);
        line-height: 1.65;
        flex-grow: 1;
        font-size: 0.93rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .note-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .note-shared-badge {
        font-size: 0.78rem;
        color: var(--secondary);
        font-weight: 700;
    }

    .note-actions {
        display: flex;
        gap: 8px;
    }

    .link-action {
        background: transparent;
        border: 0;
        color: var(--primary);
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s ease;
        font-size: 0.9rem;
        padding: 4px 8px;
        border-radius: 8px;
    }

        .link-action:hover {
            background: rgba(59,130,246,0.08);
            transform: translateY(-1px);
        }

        .link-action.danger {
            color: var(--error);
        }

            .link-action.danger:hover {
                background: rgba(239,68,68,0.08);
            }

    .loading-state, .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--text-soft);
        font-weight: 600;
        grid-column: 1/-1;
    }

    /* MODALES */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,0.45);
        backdrop-filter: blur(4px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        animation: fadeIn 0.18s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-box {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 32px 80px rgba(15,23,42,0.18);
        width: 100%;
        max-width: 700px;
        overflow: hidden;
        animation: slideUp 0.22s cubic-bezier(.22,1,.36,1);
        display: flex;
        flex-direction: column;
        max-height: 90vh;
    }

    .modal-editor-box {
        max-width: 820px;
    }

    .modal-ver-box {
        max-width: 700px;
    }

    @@keyframes slideUp {
        from {
            transform: translateY(24px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 20px 24px 14px;
        border-bottom: 1px solid var(--border);
    }

    .modal-close {
        background: #F8FAFC;
        border: 1px solid var(--border);
        border-radius: 10px;
        width: 34px;
        height: 34px;
        cursor: pointer;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: 0.15s ease;
    }

        .modal-close:hover {
            background: #F1F5F9;
        }

    .titulo-input {
        width: 100%;
        border: none;
        outline: none;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text);
        background: transparent;
    }

        .titulo-input::placeholder {
            color: #94A3B8;
        }

    .editor-toolbar {
        display: flex;
        gap: 4px;
        padding: 10px 20px;
        border-bottom: 1px solid var(--border);
        background: #F8FAFC;
        flex-wrap: wrap;
        align-items: center;
    }

        .editor-toolbar button {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 8px;
            width: 34px;
            height: 34px;
            cursor: pointer;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.15s ease;
            font-family: inherit;
            color: var(--text);
        }

            .editor-toolbar button:hover {
                background: rgba(59,130,246,0.08);
                border-color: rgba(59,130,246,0.2);
                color: var(--primary);
            }

        .editor-toolbar .sep {
            width: 1px;
            height: 24px;
            background: var(--border);
            margin: 0 4px;
        }

    .nota-editor {
        flex: 1;
        min-height: 260px;
        max-height: 380px;
        overflow-y: auto;
        padding: 20px 24px;
        outline: none;
        font-size: 0.97rem;
        line-height: 1.75;
        color: var(--text);
        background: #fff;
    }

        .nota-editor:empty:before {
            content: attr(placeholder);
            color: #94A3B8;
            pointer-events: none;
        }

        .nota-editor h2 {
            font-size: 1.2rem;
            margin: 14px 0 8px;
        }

        .nota-editor ul, .nota-editor ol {
            padding-left: 22px;
        }

        .nota-editor li {
            margin: 4px 0;
        }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 24px 20px;
        border-top: 1px solid rgba(226,232,240,0.7);
        flex-wrap: wrap;
    }

    .share-section {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

        .share-section input {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.92rem;
            outline: none;
            transition: 0.2s ease;
            min-width: 200px;
        }

            .share-section input:focus {
                border-color: rgba(99,102,241,0.45);
                box-shadow: 0 0 0 3px rgba(99,102,241,0.10);
            }

    .footer-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .nota-error {
        color: #B91C1C;
        font-size: 0.88rem;
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.16);
        padding: 8px 12px;
        border-radius: 10px;
    }

    .modal-meta {
        padding: 8px 24px 0;
        color: var(--text-soft);
        font-size: 0.88rem;
    }

    .ver-nota-content {
        flex: 1;
        overflow-y: auto;
        padding: 16px 24px 24px;
        font-size: 0.97rem;
        line-height: 1.75;
        color: var(--text);
        min-height: 200px;
        max-height: 60vh;
    }

        .ver-nota-content h2 {
            font-size: 1.2rem;
            margin: 14px 0 8px;
        }

        .ver-nota-content ul, .ver-nota-content ol {
            padding-left: 22px;
        }

    @@media (max-width: 1100px) {
        .notes-grid {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }
    }

    @@media (max-width: 700px) {
        .notes-grid {
            grid-template-columns: 1fr;
        }

        .workspace-page {
            padding: 20px 12px 32px;
        }

        .modal-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .share-section, .footer-actions {
            width: 100%;
        }
    }
</style>

<script>
    let todasNotas = [];
    let notaActualId = null;

    // ===== UTILIDADES =====
    function openModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    function closeModalOutside(e, id) { if (e.target.id === id) closeModal(id); }

    function escapeHtml(str) {
        const d = document.createElement('div'); d.textContent = str ?? ''; return d.innerHTML;
    }

    function formatDate(iso) {
        if (!iso) return '';
        const d = new Date(iso);
        return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function stripHtml(html) {
        const d = document.createElement('div'); d.innerHTML = html; return d.textContent || d.innerText || '';
    }

    // ===== EDITOR FORMAT =====
    function fmt(cmd) { document.execCommand(cmd, false, null); document.getElementById('notaEditor').focus(); }
    function fmtBlock(tag) { document.execCommand('formatBlock', false, tag); document.getElementById('notaEditor').focus(); }

    // ===== CARGAR NOTAS =====
    async function cargarNotas() {
        try {
            const res = await fetch('/api/notas');
            if (!res.ok) throw new Error();
            const notas = await res.json();
            todasNotas = notas;
            renderNotas(notas);
        } catch {
            document.getElementById('notasGrid').innerHTML =
                '<div class="empty-state">No se pudieron cargar las notas. Asegúrate de haber iniciado sesión.</div>';
        }
    }

    function renderNotas(notas) {
        const grid = document.getElementById('notasGrid');
        if (!notas || notas.length === 0) {
            grid.innerHTML = `
                <div class="empty-state">
                    <p>No tienes notas todavía.</p>
                    <p>Crea tu primera nota con el botón "+ Nueva nota".</p>
                </div>`;
            return;
        }
        grid.innerHTML = notas.map(n => {
            const preview = stripHtml(n.contenido || '').substring(0, 150);
            const isShared = n.compartidaCon && n.compartidaCon.length > 0;
            return `
                <article class="note-card ${isShared ? 'shared-card' : ''}">
                    <div class="note-card-top">
                        <span class="note-tag ${n.esPropia ? 'blue' : 'violet'}">${n.esPropia ? 'Mía' : 'Compartida'}</span>
                        <span class="note-date">${formatDate(n.fechaActualizacion || n.fechaCreacion)}</span>
                    </div>
                    <h3>${escapeHtml(n.titulo || 'Sin título')}</h3>
                    <p>${escapeHtml(preview)}${preview.length >= 150 ? '...' : ''}</p>
                    <div class="note-card-footer">
                        ${isShared ? `<span class="note-shared-badge">↗ Compartida con ${escapeHtml(n.compartidaCon.join(', '))}</span>` : '<span></span>'}
                        <div class="note-actions">
                            <button class="link-action" onclick="verNota(${n.id})">Ver</button>
                            ${n.esPropia ? `<button class="link-action" onclick="editarNota(${n.id})">Editar</button>` : ''}
                            ${n.esPropia ? `<button class="link-action danger" onclick="borrarNota(${n.id})">Borrar</button>` : ''}
                        </div>
                    </div>
                </article>
            `;
        }).join('');
    }

    function filtrarNotas() {
        const q = document.getElementById('searchNotas').value.toLowerCase().trim();
        if (!q) { renderNotas(todasNotas); return; }
        renderNotas(todasNotas.filter(n =>
            (n.titulo || '').toLowerCase().includes(q) ||
            stripHtml(n.contenido || '').toLowerCase().includes(q)
        ));
    }

    // ===== NUEVA NOTA =====
    function abrirEditorNueva() {
        notaActualId = null;
        document.getElementById('notaTitulo').value = '';
        document.getElementById('notaEditor').innerHTML = '';
        document.getElementById('shareUsername').value = '';
        document.getElementById('notaError').style.display = 'none';
        openModal('modalNota');
        document.getElementById('notaTitulo').focus();
    }

    // ===== EDITAR NOTA =====
    function editarNota(id) {
        const nota = todasNotas.find(n => n.id === id);
        if (!nota) return;
        notaActualId = id;
        document.getElementById('notaTitulo').value = nota.titulo || '';
        document.getElementById('notaEditor').innerHTML = nota.contenido || '';
        document.getElementById('shareUsername').value = '';
        document.getElementById('notaError').style.display = 'none';
        closeModal('modalVerNota');
        openModal('modalNota');
        document.getElementById('notaTitulo').focus();
    }

    function editarDesdeVer() {
        closeModal('modalVerNota');
        if (notaActualId) editarNota(notaActualId);
    }

    // ===== VER NOTA =====
    function verNota(id) {
        const nota = todasNotas.find(n => n.id === id);
        if (!nota) return;
        notaActualId = id;
        document.getElementById('verNotaTitulo').textContent = nota.titulo || 'Sin título';
        document.getElementById('verNotaMeta').textContent =
            `${nota.esPropia ? 'Tuya' : 'Compartida'} · ${formatDate(nota.fechaActualizacion || nota.fechaCreacion)}`;
        document.getElementById('verNotaContenido').innerHTML = nota.contenido || '<em style="color:#94A3B8">Nota vacía</em>';

        // Mostrar botón editar solo si es propia
        const editBtn = document.querySelector('#modalVerNota .btn-primary-custom');
        if (editBtn) editBtn.style.display = nota.esPropia ? '' : 'none';

        openModal('modalVerNota');
    }

    // ===== GUARDAR NOTA =====
    async function guardarNota() {
        const titulo = document.getElementById('notaTitulo').value.trim();
        const contenido = document.getElementById('notaEditor').innerHTML.trim();
        const errEl = document.getElementById('notaError');
        errEl.style.display = 'none';

        if (!titulo) { errEl.textContent = 'El título es obligatorio.'; errEl.style.display = 'block'; return; }
        if (!contenido || contenido === '<br>') { errEl.textContent = 'Escribe algo en la nota.'; errEl.style.display = 'block'; return; }

        try {
            const url = notaActualId ? `/api/notas/${notaActualId}` : '/api/notas';
            const method = notaActualId ? 'PUT' : 'POST';

            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ titulo, contenido })
            });

            if (!res.ok) {
                const d = await res.json();
                errEl.textContent = d.error || 'Error al guardar.';
                errEl.style.display = 'block';
                return;
            }

            closeModal('modalNota');
            await cargarNotas();
        } catch {
            errEl.textContent = 'Error de conexión.';
            errEl.style.display = 'block';
        }
    }

    // ===== BORRAR NOTA =====
    async function borrarNota(id) {
        if (!confirm('¿Seguro que quieres borrar esta nota?')) return;
        try {
            await fetch(`/api/notas/${id}`, { method: 'DELETE' });
            await cargarNotas();
        } catch { alert('Error al borrar la nota.'); }
    }

    // ===== COMPARTIR NOTA =====
    async function compartirNota() {
        if (!notaActualId) {
            // Guardar primero si es nueva
            const errEl = document.getElementById('notaError');
            errEl.textContent = 'Primero guarda la nota para poder compartirla.';
            errEl.style.display = 'block';
            return;
        }

        const username = document.getElementById('shareUsername').value.trim();
        if (!username) return;

        const errEl = document.getElementById('notaError');
        errEl.style.display = 'none';

        try {
            const res = await fetch(`/api/notas/${notaActualId}/compartir`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });

            const d = await res.json();
            if (!res.ok) {
                errEl.textContent = d.error || 'No se pudo compartir.';
                errEl.style.display = 'block';
                return;
            }

            document.getElementById('shareUsername').value = '';
            // Feedback visual
            const btn = document.querySelector('.share-section .btn-soft');
            if (btn) {
                const orig = btn.textContent;
                btn.textContent = '✓ Compartida';
                btn.style.color = 'var(--success)';
                setTimeout(() => { btn.textContent = orig; btn.style.color = ''; }, 2000);
            }
            await cargarNotas();
        } catch {
            errEl.textContent = 'Error de conexión.';
            errEl.style.display = 'block';
        }
    }

    // ===== INICIO =====
    cargarNotas();
</script>
